<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="comment_scraper.sqlite3" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2419"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Comments" custom_title="0" dock_id="1" table="4,8:mainComments"/><dock_state state="000000ff00000000fd000000010000000200000528000003d6fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005280000013300ffffff000002680000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Comments" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="300"/><column index="2" value="210"/><column index="3" value="93"/><column index="4" value="210"/><column index="5" value="163"/><column index="6" value="163"/><column index="7" value="300"/><column index="8" value="40"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Threads" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="210"/><column index="2" value="93"/><column index="3" value="210"/><column index="4" value="107"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Videos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="93"/><column index="2" value="195"/><column index="3" value="163"/><column index="4" value="300"/><column index="5" value="300"/><column index="6" value="163"/><column index="7" value="300"/><column index="8" value="152"/><column index="9" value="163"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">Select v.Video_Title, Video_Description
From Comments c
Join Videos v on c.videoID = v.videoID
where v.videoID = '_kK0g12iSTw'</sql><sql name="SQL 2*">Select Comment_ID, Comment_Text
From Comments
where Comment_ID in (
'UgwWtiSu_IVcgAHka3x4AaABAg' ,
'UgzRq6DyPZWww2VmtAB4AaABAg',
'UgzsIMExmiTZHWgr_M54AaABAg.A_ZpL4pOaC9A_ZuReVNV_E',
'Ugy6OKO9R3QpGAQr2wN4AaABAg',
'Ugx_ruSRGS8InAf5xN14AaABAg'
)</sql><sql name="SQL 3*">BEGIN TRANSACTION;

-- 1. Kommentare aus dem Retrieval-Testdatensatz löschen
DELETE FROM data_set_retrieval_testing
WHERE Comment_ID IN (
    SELECT c.Comment_ID
    FROM Comments c
    JOIN Videos v ON c.VideoID = v.videoID
    WHERE v.channel_title = 'VisualPolitik DE'
);

-- 2. Alle Kommentare zu VisualPolitik-Videos löschen
DELETE FROM Comments
WHERE VideoID IN (
    SELECT videoID
    FROM Videos
    WHERE channel_title = 'VisualPolitik DE'
);

-- 3. Alle Threads zu VisualPolitik-Videos löschen
DELETE FROM Threads
WHERE videoID IN (
    SELECT videoID
    FROM Videos
    WHERE channel_title = 'VisualPolitik DE'
);

-- 4. Die VisualPolitik-Videos selbst löschen
DELETE FROM Videos
WHERE channel_title = 'VisualPolitik DE';

COMMIT;</sql><current_tab id="2"/></tab_sql></sqlb_project>
